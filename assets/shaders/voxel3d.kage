package title

//kage:unit pixels

// Scaling and Rotation
var VoxelModelMatrixInverse mat4

// Light Direction Uniform
var LightDirection vec3

// Atlas/Sampling Params
var FrameSize vec2 // Renamed from IFrameSize
var Frames float   // Renamed from IFrames

// Rendering Params
var RenderMode int // Keep 0=Color, 1=Shadow, 2=Hit Highlight (to avoid blend step outside)

func Fragment(position vec4) vec4 {
	uv := calculateScreenUV(position.xy)
	rnd := random(uv.xy) * 0.0025
	startPos := vec3(uv.x, uv.y, 0.5)
	startPos.z += rnd

	// Transform light direction to local space
	localLightDirection := normalize((VoxelModelMatrixInverse * vec4(LightDirection, 0.0)).xyz)

	// Return the result from the ray marching
	return marchRay(startPos, localLightDirection)
}

// --- Helper: Calculate normalized screen UV (-0.5 to 0.5) ---
func calculateScreenUV(fragCoord vec2) vec2 {
	dstOrigin := imageDstOrigin()
	dstSize := imageDstSize()
	uv := (fragCoord-dstOrigin)/dstSize - 0.5
	return uv
}

// --- Simple pseudo-random noise based on screen position ---
func random(st vec2) float {
	return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123)
}

// --- Core: March a ray and accumulate color ---
func marchRay(pos vec3, lightDirection vec3) vec4 {
	accumulatedColor := vec4(0.0) // Premultiplied alpha
	accumulations := 0

	const numSteps = 128
	const stepSize = 1.0 / float(numSteps)

	for i := 0; i < numSteps; i++ {
		// Get raw color from volume map
		baseColor := sampleShadedVolume(pos)

		if baseColor.a > 0.0 {
			if RenderMode == 0 {
				// Calculate shadow factor for the current position
				rotatedScaledPos := (VoxelModelMatrixInverse * vec4(pos, 1.0)).xyz
				shadowFactor := calculateShadowFactor(rotatedScaledPos, lightDirection)
				baseColor.xyz *= shadowFactor

				if baseColor.a == 1 {
					if accumulations > 0 {
						accumulatedColor /= float(accumulations)
						a := (1.0 - accumulatedColor.a) / float(accumulations)
						baseColor.rgb *= a
						accumulatedColor.rgb *= 1.0 - a
						accumulatedColor.a = 1.0
						return accumulatedColor + baseColor
					} else {
						return baseColor
					}
				} else {
					accumulatedColor += baseColor
					accumulations++
				}
			} else if RenderMode == 1 { // Shadow Mode
				return vec4(0.0, 0.0, 0.0, 0.5)
			} else if RenderMode == 2 { // Hit Highlight Mode
				return vec4(1.0)
			}
		}

		// Break early when we step past the -0.5 boundary
		pos.z -= stepSize
		if pos.z < -0.5 {
			break
		}
	}

	if accumulations > 0 {
		accumulatedColor /= float(accumulations)
		return accumulatedColor
	}
	return vec4(0.0)
}

// --- Core: Get base color (Shadow calculation moved to marchRay) ---
func sampleShadedVolume(posUnrotated vec3) vec4 {
	rotatedScaledPos := (VoxelModelMatrixInverse * vec4(posUnrotated, 1.0)).xyz
	// Directly return the color from the volume map
	return volumeMap(rotatedScaledPos)
}

// lookup volume xyz in -0.5 to 0.5 range in the sliced texture.
// x is x, z is y, y is z -> y is the slice index.
// texture is made of Frames slices.
// Assumes FrameSize.y is the height of ONE slice.
func volumeMap(pos vec3) vec4 {
	if isOutOfBounds(pos) {
		return vec4(0)
	}
	uv := calculateAtlasUV(pos)
	return imageSrc0At(uv)
}

// --- Helper: Check if position is within the standard -0.5 to 0.5 cube ---
func isOutOfBounds(pos vec3) bool {
	return -0.5 > pos.x || pos.x > 0.5 ||
		-0.5 > pos.y || pos.y > 0.5 ||
		-0.5 > pos.z || pos.z > 0.5
}

// --- Helper: Calculate texture UV coordinates from a local position ---
func calculateAtlasUV(pos vec3) vec2 {
	uv := imageSrc0Origin()
	uv.x += (pos.x + 0.5) * FrameSize.x
	uv.y += (pos.z + 0.5) * FrameSize.y
	slice := floor((pos.y + 0.5) * Frames)
	offset := slice * FrameSize.y
	uv.y += offset
	return uv
}

// --- Helper: Calculate the shadow factor based on light direction ---
func calculateShadowFactor(pos vec3, lightDirection vec3) float {
	const stepSize = 1 / 64.0
	shadowOffset := lightDirection * stepSize

	const numSteps = 16
	const darknessMin = 0.8
	const darknessStep = (1.0 - darknessMin) / float(numSteps)
	darkness := darknessMin

	hitBefore := false
	for i := 0; i < numSteps; i++ {
		pos -= shadowOffset
		if volumeMap(pos).a > 0.0 {
			if hitBefore {
				return darkness // In shadow
			}
			hitBefore = true
		}
		darkness += darknessStep
	}

	return 1.0 // Not in shadow
}
